{
  "name": "lamp-light",
  "version": "1.2.7",
  "description": "Lamp & Light — offline-first Bible trivia, reading, and practice",
  "author": "Lamp & Light",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "kill-port 5173 && wait-on --reverse tcp:5173 && tsc -p tsconfig.electron.json && concurrently -k \"vite --strictPort\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node scripts/launch-electron.cjs\"",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "test": "vitest run",
    "check": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always",
    "verify:packaged": "node scripts/verify-packaged-app.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@vitejs/plugin-react": "latest",
    "electron-updater": "^6.8.9",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "37.4.0",
    "electron-builder": "latest",
    "kill-port": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "org.lamplight.desktop",
    "productName": "Lamp & Light",
    "executableName": "Lamp Light",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lioneltchami",
        "repo": "Lamp-Light",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "dist-electron/**/*",
      "electron/preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "content",
        "to": "content",
        "filter": [
          "*.txt",
          "LICENSES.md"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "Lamp-Light-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "artifactName": "Lamp-Light-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSUserNotificationUsageDescription": "Lamp & Light can remind you about today’s daily question."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
