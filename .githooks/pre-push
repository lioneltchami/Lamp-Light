#!/bin/sh
# Block direct pushes to main/master. Day-to-day branch is dev.
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')

while read -r local_ref local_sha remote_ref remote_sha
do
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo ""
      echo "Blocked: direct push to ${remote_ref#refs/heads/}."
      echo "Push to 'dev' (or a feature branch), then open a PR into main."
      echo "  git push -u origin HEAD:dev"
      echo ""
      exit 1
      ;;
  esac
done

exit 0
